# Copy to .env (repository root) and adjust. Never commit real credentials.
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commerceos
# Log SQL queries (true/false)
DATABASE_DEBUG=false

APP_URL=http://localhost:3000

# Admin authentication (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Only behind a proxy that overwrites this header (e.g. x-real-ip). Leave unset locally:
# sign-in is then rate-limited globally instead of trusting a forgeable header.
# AUTH_TRUSTED_IP_HEADER=x-real-ip

# Read only by `npm run admin:create` (never by the app). Password: at least 12 characters.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=
