{
  "name": "@commerceos/app",
  "version": "0.1.0",
  "private": true,
  "description": "CommerceOS Next.js application: storefront, admin dashboard, API routes and DI composition root",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "admin:create": "tsx src/server/auth/cli/create-owner.ts",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "test:storybook": "vitest run --config vitest.storybook.config.mts --project storybook-light",
    "test:storybook:dark": "vitest run --config vitest.storybook.config.mts --project storybook-dark",
    "test:storybook:themes": "vitest run --config vitest.storybook.config.mts",
    "check:tokens": "tsx scripts/check-tokens.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@commerceos/ai": "*",
    "@commerceos/core": "*",
    "@commerceos/database": "*",
    "@tabler/icons-react": "^3.50.0",
    "awilix": "^13.0.5",
    "better-auth": "~1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commerceos/config": "*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.5",
    "tailwindcss": "^4",
    "vite": "^8.3.4"
  }
}
